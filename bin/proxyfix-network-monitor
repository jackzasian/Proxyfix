#!/usr/bin/env bash
# Run proxyfix on connectivity changes (WiFi switch, etc.) via `ip monitor route`.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROXYFIX="${PROXYFIX:-$(cd "${SCRIPT_DIR}/.." && pwd)/proxyfix}"
DEBOUNCE_SEC=5
LAST_RUN=0

run_fix() {
  local now reason=$1
  now=$(date +%s)
  if (( now - LAST_RUN < DEBOUNCE_SEC )); then
    return 0
  fi
  LAST_RUN=$now
  logger -t proxyfix-network "fix triggered: ${reason}"
  sleep 2
  "$PROXYFIX" fix --quiet || true
}

# iproute2's `ip monitor` emits default-route add/delete events on any
# connectivity change, so this works with iwd, NetworkManager, or systemd-networkd
# without depending on nmcli.
if ! command -v ip >/dev/null 2>&1; then
  logger -t proxyfix-network "ip(8) missing — network monitor exiting"
  exit 1
fi

# Initial fix after login / service start
run_fix "service-start"

ip monitor route 2>/dev/null | while read -r line; do
  case "$line" in
    *default*)
      run_fix "$line"
      ;;
  esac
done
